# Resend API key, used by src/app/api/contact/route.ts to deliver the contact
# form. Get one at https://resend.com/api-keys after verifying wwwdot.dev as a
# sending domain (Resend > Domains > Add Domain > add the DNS records it gives
# you in Vercel > Domains > wwwdot.dev > DNS Records).
RESEND_API_KEY=

# Optional overrides. Defaults live in the route itself if unset.
# CONTACT_FROM="wwwdot.dev <contact@wwwdot.dev>"
# CONTACT_TO="contact@wwwdot.dev"
